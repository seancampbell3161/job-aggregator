# Hosted tailor endpoint — container image (WeasyPrint + ollama + résumé data baked in).
FROM public.ecr.aws/lambda/python:3.12

# WeasyPrint native deps on Amazon Linux 2023 (the base image's distro).
RUN dnf install -y pango cairo gdk-pixbuf2 libffi fontconfig && dnf clean all

# Install the project (runtime deps) + the render extra (WeasyPrint + Jinja2).
COPY pyproject.toml README.md LICENSE ${LAMBDA_TASK_ROOT}/
COPY src/ ${LAMBDA_TASK_ROOT}/src/
RUN pip install --no-cache-dir "${LAMBDA_TASK_ROOT}[render]"

# Bake config + résumé data + fonts (read relative to WORKDIR=/var/task=LAMBDA_TASK_ROOT).
COPY config.yaml ${LAMBDA_TASK_ROOT}/
COPY resume/content.json resume/evidence.json ${LAMBDA_TASK_ROOT}/resume/
COPY resume/fonts/ ${LAMBDA_TASK_ROOT}/resume/fonts/

# The host résumé files are mode 600 (gitignored PII); COPY preserves that, but the
# Lambda runtime runs as a non-root user and would hit PermissionError reading them.
RUN chmod -R a+rX ${LAMBDA_TASK_ROOT}/resume ${LAMBDA_TASK_ROOT}/config.yaml

CMD ["src.tailor.endpoint.handler.handler"]
