# Keep the Docker build context small. The image needs: pyproject.toml,
# README.md, LICENSE (read at build time by the packaging metadata), src/,
# scripts/seeds/, docs/CONFIG.md and docker-entrypoint.sh — nothing else.
.venv
.git
.github
data
tailored
tmp
build
tests
docs
!docs/CONFIG.md
# ^ docs/ is excluded (narrative docs, not needed at runtime) except
# CONFIG.md, which the settings UI reads at runtime for per-flag help text —
# without it every Advanced field renders with no help.
scripts
!scripts/seeds
# ^ scripts/ is excluded (CLI tooling, not needed at runtime) except seeds/,
# which the discovery tier's board sweep reads from inside the image.
**/__pycache__
*.pyc
*.egg-info
.DS_Store
**/.DS_Store
.pytest_cache
infra
resume
# ^ no runtime input lives here: built-in template packs ship inside
# src/tailor/render/templates/, and resume/content.json + resume/evidence.json
# are personal files that must never enter an image.
