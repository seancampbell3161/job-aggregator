# Copy to .env and fill in. Compose loads this via env_file.

# --- Backend selection ---
JOB_AGG_BACKEND=sqlite
JOB_AGG_SQLITE_PATH=/data/job_aggregator.db
JOB_AGG_TAILORED_DIR=/data/tailored

# --- Notifications (required) ---
JOB_AGG_NTFY_TOPIC_URL=https://ntfy.sh/your-topic
JOB_AGG_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --- LLM scoring (optional; pick ONE provider via config.yaml `relevance.provider`) ---
# Cloud providers (provider: anthropic | gemini):
JOB_AGG_ANTHROPIC_API_KEY=
JOB_AGG_GOOGLE_API_KEY=
# Ollama (provider: ollama) — two ways:
#   Local container : keep the host below, leave the key empty; start with `--profile ollama`.
#   Ollama Cloud    : set JOB_AGG_OLLAMA_HOST=https://ollama.com and a key; start WITHOUT the profile.
JOB_AGG_OLLAMA_HOST=http://ollama:11434
JOB_AGG_OLLAMA_API_KEY=

# --- Adzuna connector (optional; enable via sources.adzuna in config.yaml) ---
# Free self-service keys: https://developer.adzuna.com
#JOB_AGG_ADZUNA_APP_ID=
#JOB_AGG_ADZUNA_APP_KEY=

# --- Gmail rejection/receipt ingestion (optional; IMAP with a Google app password) ---
# Needs 2-Step Verification on the account; see GETTING_STARTED (Gmail ingestion).
#JOB_AGG_GMAIL_ADDRESS=
#JOB_AGG_GMAIL_APP_PASSWORD=

# --- Tailor deep-link (optional) ---
# Point at this box's web app; e.g. http://<lan-ip>:8000/tailor or a Tailscale URL.
JOB_AGG_TAILOR_ENDPOINT_URL=
JOB_AGG_TAILOR_SIGNING_SECRET=

# --- Ops alerts (trust & audit) — all optional; leave unset to disable ---
# Separate channel for pipeline-health alerts (never mixed into job alerts):
#JOB_AGG_OPS_NTFY_TOPIC_URL=https://ntfy.sh/your-ops-topic
#JOB_AGG_OPS_DISCORD_WEBHOOK_URL=
# Dead-man's-switch: GET on every successful ats cycle (e.g. healthchecks.io):
#JOB_AGG_HEARTBEAT_URL=
