# Optional. Every value below can instead be stored in the app database:
#   docker compose run --rm -it web python -m src.settings set-secret ntfy_topic_url
# or copied there once from this file:
#   docker compose run --rm web python -m src.settings import-env-secrets
# A non-empty value here always wins over the database; an empty value is ignored.
# Compose reads this file at container creation — after editing it, run
# `docker compose up -d --force-recreate`.

# --- Notifications (both optional; without them, matches still land in the web UI) ---
#JOB_AGG_NTFY_TOPIC_URL=https://ntfy.sh/your-topic
#JOB_AGG_DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --- LLM keys: set the one matching relevance.provider ---
#JOB_AGG_ANTHROPIC_API_KEY=
#JOB_AGG_GOOGLE_API_KEY=
# Hosted Ollama Cloud only; a local Ollama server needs no key.
#JOB_AGG_OLLAMA_API_KEY=
# Overrides relevance.ollama_host (default http://ollama:11434), e.g. for Ollama Cloud:
#JOB_AGG_OLLAMA_HOST=https://ollama.com

# --- Adzuna connector (sources.adzuna); free keys: https://developer.adzuna.com ---
#JOB_AGG_ADZUNA_APP_ID=
#JOB_AGG_ADZUNA_APP_KEY=

# --- Gmail ingestion (IMAP with a Google app password; see GETTING_STARTED) ---
#JOB_AGG_GMAIL_ADDRESS=
#JOB_AGG_GMAIL_APP_PASSWORD=

# --- Tailor deep link ---
# This box's web app, e.g. http://<lan-ip>:8000/tailor or a Tailscale URL.
#JOB_AGG_TAILOR_ENDPOINT_URL=
# Generated and stored in the database on first boot; set only to pin a value.
#JOB_AGG_TAILOR_SIGNING_SECRET=

# --- Ops alerts (all optional) ---
#JOB_AGG_OPS_NTFY_TOPIC_URL=https://ntfy.sh/your-ops-topic
#JOB_AGG_OPS_DISCORD_WEBHOOK_URL=
# Dead-man's-switch: GET on every successful ats cycle (e.g. healthchecks.io):
#JOB_AGG_HEARTBEAT_URL=
